{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/server.ts",
    "src/Core/**/*",
    "src/Domain/**/*",
    "src/Ports/**/*",
    "src/App/**/*",
    "src/Infra/**/*"
  ],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/App/TaskContext.tsx",
    "src/Infra/HttpTaskRepository.ts"
  ]
}
